#include "zmk-helpers/helper.h"
#include "zmk-helpers/key-labels/adv360.h"
#include <behaviors.dtsi>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/rgb.h>
#include <dt-bindings/zmk/stp.h>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/pointing.h>
#define KEYS_L LN0 LN1 LN2 LN3 LN4 LN5 LT0 LT1 LT2 LT3 LT4 LT5 LM0 LM1 LM2 LM3 LM4 LM5 LB0 LB1 LB2 LB3 LB4 LB5
#define KEYS_R RN0 RN1 RN2 RN3 RN4 RN5 RT0 RT1 RT2 RT3 RT4 RT5 RM0 RM1 RM2 RM3 RM4 RM5 RB0 RB1 RB2 RB3 RB4 RB5
#define THUMBS LH0 LH1 LH2 RH0 RH1 RH2

ZMK_HOLD_TAP(hml,
    flavor = "balanced";
    tapping-term-ms = <200>;
    quick-tap-ms = <120>;
    retro-tap;
    bindings = <&kp>, <&kp>;
    hold-trigger-key-positions = <KEYS_R THUMBS>;
    hold-trigger-on-release;
)

// Right-hand HRMs
ZMK_HOLD_TAP(hmr,
    flavor = "balanced";
    tapping-term-ms = <200>;
    quick-tap-ms = <120>;
    retro-tap;
    bindings = <&kp>, <&kp>;
    hold-trigger-key-positions = <KEYS_L THUMBS>;
    hold-trigger-on-release;
)

ZMK_HOLD_TAP(ltl,
    flavor = "balanced";
    tapping-term-ms = <200>;
    quick-tap-ms = <120>;
    retro-tap;
    bindings = <&mo>, <&kp>;
    hold-trigger-key-positions = <KEYS_R THUMBS>;
    hold-trigger-on-release;
)

/ {
    behaviors {
      #include "macros.dtsi"
      #include "version.dtsi"

      hm: homerow_mods {
          compatible = "zmk,behavior-hold-tap";
          label = "HOMEROW_MODS";
          #binding-cells = <2>;
          tapping-term-ms = <200>;
          quick_tap_ms = <120>;
          flavor = "tap-preferred";
          bindings = <&kp>, <&kp>;
      };

      lt_s: layer_tap_symbols {
          compatible = "zmk,behavior-hold-tap";
          label = "LAYER_TAP_SYM";
          #binding-cells = <2>;
          tapping-term-ms = <200>;
          quick_tap_ms = <120>;
          flavor = "balanced";
          bindings = <&mo>, <&kp>;
      };

      lt_d: layer_tap_pairs {
          compatible = "zmk,behavior-hold-tap";
          label = "LAYER_TAP_PAIRS";
          #binding-cells = <2>;
          tapping-term-ms = <200>;
          quick_tap_ms = <120>;
          flavor = "balanced";
          bindings = <&mo>, <&kp>;
      };

      lt_f: layer_tap_keypad {
          compatible = "zmk,behavior-hold-tap";
          label = "LAYER_TAP_KEYPAD";
          #binding-cells = <2>;
          tapping-term-ms = <200>;
          quick_tap_ms = <120>;
          flavor = "balanced";
          bindings = <&mo>, <&kp>;
      };
    };

  keymap {
    compatible = "zmk,keymap";

    default_layer {
      display-name = "Base";
      bindings = <
        &kp PSCRN  &sl 2     &kp LPAR    &kp LBRC    &kp LBKT     &kp LT &tog 1                                                           &mo 4    &kp GT   &kp RBKT     &kp RBRC        &kp RPAR      &word_the   &sl 3
        &kp TAB    &kp Q     &kp W       &kp E       &kp R        &kp T  &none                                                            &kp C_PP &kp Y    &kp U        &kp I           &kp O         &kp P       &kp BSLH
        &kp ESC    &kp A     &ltl 3 S    &ltl 2 D    &ltl 1 F     &kp G  &none          &kp LCTRL &kp LALT &kp LGUI  &kp RCTRL            &none    &kp H    &kp J        &kp K           &kp L         &kp SEMI    &kp SQT
        &kp LSHFT  &kp Z     &hml LGUI X &hml LALT C &hml LCTRL V &kp B                           &kp HOME &kp PG_UP                               &kp N    &hmr RCTRL M &hmr RALT COMMA &hmr RGUI DOT &kp FSLH    &kp RSHFT
        &caps_word &kp GRAVE &kp CAPS    &none       &none                       &kp BSPC &kp DEL &kp END  &kp PG_DN &kp ENTER &kp SPACE                    &kp C_VOL_UP &kp C_VOL_DN    &kp C_PREV    &kp C_NEXT  &mo 5
      >;
    };
    keypad {
      display-name = "Keypad";
      bindings = <
        &trans    &trans    &trans   &trans   &trans     &trans &trans                                                           &mo 4  &trans      &trans  &trans    &trans     &trans  &trans
        &trans    &trans    &trans   &trans   &trans     &trans &trans                                                           &trans &kp KP_PLUS &kp N7 &kp N8   &kp N9     &trans  &trans
        &trans    &trans    &trans   &trans   &trans     &trans &trans          &trans    &trans    &trans    &trans             &trans &kp EQUAL   &kp N4  &kp N5    &kp N6     &trans  &trans
        &trans    &trans    &trans   &trans   &trans     &trans                           &trans    &trans                              &kp MINUS   &kp N1  &kp N2    &kp N3     &trans  &trans
        &trans    &trans    &trans   &trans   &trans                   &trans    &trans   &trans    &trans    &trans    &kp N0                      &kp N0  &kp COMMA &kp DOT &trans  &trans
      >;
    };
    pairs {
      display-name = "Nav";
      bindings = <
        &trans    &trans    &trans    &trans    &trans    &trans &trans                                                           &mo 4  &trans        &trans         &trans       &trans           &trans           &trans
        &trans    &trans    &trans    &trans    &trans    &trans &trans                                                           &trans &kp LC(HOME)  &kp PG_DN      &kp PG_UP    &kp PG_UP        &kp LC(RIGHT)    &kp LC(END)
        &trans    &trans    &trans    &trans    &trans    &trans &trans          &trans    &trans    &trans    &trans             &trans &kp LEFT      &kp DOWN       &kp UP       &kp RIGHT        &trans           &kp END
        &trans    &trans    &trans    &trans    &trans    &trans                           &trans    &trans                              &kp LC(LS(Z)) &kp LC(Z)      &kp LC(X)    &kp LC(C)        &kp LC(V)        &trans
        &trans    &trans    &trans    &kp LEFT  &kp DOWN                &trans    &trans   &trans    &trans    &trans    &trans                        &kp LC(Y)      &kp LC(A)    &macro_arrow_l   &macro_arrow_r   &macro_fat_arrow
      >;
    };
    symbols {
      display-name = "Symbols";
      bindings = <
        &trans    &trans    &trans    &trans    &trans    &trans &trans                                                           &mo 4  &email_personal    &email_work &email_alt  &url_keymap &trans   &trans
        &trans    &trans    &trans    &trans    &trans    &trans &trans                                                           &trans &trans             &kp AMPS    &kp STAR    &kp UNDER   &trans      &trans
        &trans    &trans    &trans    &trans    &trans    &trans &trans          &trans    &trans    &trans    &trans             &trans &trans             &kp DLLR    &kp PRCNT   &kp CARET   &kp GRAVE   &trans
        &trans    &trans    &trans    &trans    &trans    &trans                           &trans    &trans                              &trans             &kp EXCL    &kp AT      &kp HASH    &kp TILDE   &trans
        &trans    &trans    &trans    &trans    &trans                   &trans    &trans  &trans    &trans    &trans    &trans                             &trans      &trans      &trans      &trans      &trans
      >;
    };
    mod {
      display-name = "Mod";
      bindings = <
        &none          &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4 &out OUT_TOG                                                                   &trans       &none        &none        &none        &none &none &none
        &none          &none        &none        &none        &none        &none        &bootloader                                                                    &bootloader  &none        &none        &none        &none &none &none
        &studio_unlock &none        &none        &none        &none        &none        &none                         &none &none  &bt BT_CLR &none                    &stp STP_BAT &none        &none        &none        &none &none &none
        &none          &none        &none        &none        &macro_ver   &none                                      &none        &none                                            &none        &none        &none        &none &none &none
        &none          &none        &none        &none        &none                                       &none &none &none        &none &bl BL_TOG &rgb_ug RGB_TOG                              &bl BL_INC   &bl BL_DEC   &none &none &none
      >;
    };
    function {
      display-name = "Function";
      bindings = <
        &kp F1    &kp F2    &kp F3    &kp F4    &kp F5    &kp F6  &kp F6                                                           &trans  &kp F7  &kp F8       &kp F9       &kp F10     &kp F11     &kp F12
        &trans    &kp F12   &trans    &trans    &trans    &trans  &trans                                                           &trans  &trans  &trans       &trans       &trans      &trans      &trans
        &trans    &trans    &trans    &trans    &trans    &trans  &trans            &trans  &trans    &trans    &trans             &trans  &trans  &trans       &trans       &trans      &trans      &trans
        &trans    &trans    &trans    &trans    &trans    &trans                            &trans    &trans                               &trans  &trans       &trans       &trans      &trans      &trans
        &trans    &trans    &trans    &kp C_PREV &kp C_NEXT               &trans    &trans  &trans    &trans    &kp C_PP   &trans                  &kp C_VOL_UP &kp C_VOL_DN &kp C_MUTE  &trans      &trans
      >;
    };
    extra1 { 
      display-name = "Red";    
      status = "reserved";
    };

    extra2 { 
      display-name = "Purple";    
      status = "reserved";
    };

    extra3 { 
      display-name = "Cyan";    
      status = "reserved";
    };

    extra4 { 
      display-name = "Yellow";    
      status = "reserved";
    };
  };
};
